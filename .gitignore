# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Cloned reference repos (audited, not vendored) -- see reports/release_audit.md
refs/

# Data / artifacts -- never commit embeddings, logits, images, checkpoints.
# These live on Google Drive, not in git (AGENTS.md §3).
data/**/*.npy
data/**/*.npz
data/**/*.pt
data/**/*.pth
data/**/images/
*.ckpt
extract_cache/

# Reports: commit the .md/.json findings, ignore heavy intermediate dumps
reports/**/*.npy
reports/**/*.npz

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Run artefact folders copied back from Colab -- kept out of git on purpose.
# The findings live in pcc/reports/*.md; the raw per-configuration JSONs are bulky
# and belong in Drive, not here.
#
# The pattern used to be nb0*_2*/, which silently stopped matching at notebook 10:
# nb12_20260817_164542/ showed up as untracked rather than ignored, one `git add -A`
# away from being committed. Any digits now, so notebook 13 and beyond are covered.
nb[0-9]*_2*/
runs/
