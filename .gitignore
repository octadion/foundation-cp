# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Cloned reference repos (audited, not vendored) -- see reports/release_audit.md
refs/

# Data / artifacts -- never commit embeddings, logits, images, checkpoints.
# These live on Google Drive, not in git (AGENTS.md §3).
data/**/*.npy
data/**/*.npz
data/**/*.pt
data/**/*.pth
data/**/images/
*.ckpt
extract_cache/

# Reports: commit the .md/.json findings, ignore heavy intermediate dumps
reports/**/*.npy
reports/**/*.npz

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Run artefact folders copied back from Colab -- kept out of git on purpose.
# The findings live in pcc/reports/*.md; the raw per-configuration JSONs are bulky
# and belong in Drive, not here.
#
# The pattern used to be nb0*_2*/, which silently stopped matching at notebook 10:
# nb12_20260817_164542/ showed up as untracked rather than ignored, one `git add -A`
# away from being committed. Any digits now, so notebook 13 and beyond are covered.
nb[0-9]*_2*/
runs/

# Sumber paper DILACAK -- 158 KB teks polos, dan draftnya adalah deliverable utama.
# Dua kerusakan senyap pada .tex sudah terjadi dalam satu hari: dua penggantian string
# yang gagal tanpa suara (judul tetap template, lima seksi tidak pernah dipanggil), dan
# heredoc Bash yang memakan backslash di 15 baris tabel. Keduanya baru ketahuan setelah
# Overleaf gagal kompilasi; dengan riwayat, keduanya satu `git diff`. Melacak wacv.sty
# juga memaku versi tata letak, yang menentukan batas 8 halaman.
#
# Yang diabaikan hanya arsipnya dan hasil kompilasi, dipersempit ke folder ini supaya
# pola seperti *.log tidak diam-diam menyentuh bagian lain repo.
wacv-2027-author-kit-template.zip
wacv-2027-author-kit-template/**/*.aux
wacv-2027-author-kit-template/**/*.bbl
wacv-2027-author-kit-template/**/*.blg
wacv-2027-author-kit-template/**/*.fdb_latexmk
wacv-2027-author-kit-template/**/*.fls
wacv-2027-author-kit-template/**/*.log
wacv-2027-author-kit-template/**/*.out
wacv-2027-author-kit-template/**/*.synctex.gz
wacv-2027-author-kit-template/**/main.pdf
# figures/ berisi gambar hasil scripts/make_figures.py, bukan hasil kompilasi.
# Pola *.pdf yang lama menelannya, dan tanpa berkas itu Overleaf gagal build.
!wacv-2027-author-kit-template/**/figures/*.pdf
# Laporan reviewer AI: masukan, bukan sumber. Pola lama hanya menutup berkas
# pertama, jadi unduhan kedua muncul sebagai untracked.
Stanford Agentic Reviewer*.pdf
2507.06867v3.pdf
